{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        "schedule:weekly"
    ],
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "branchPrefix": "grafanarenovatebot/",
    "platformCommit": "enabled",
    "dependencyDashboard": false,
    "rebaseWhen": "behind-base-branch",
    "separateMajorMinor": false,
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "osvVulnerabilityAlerts": true,
    "packageRules": [
        {
            "description": "Keep franz-go on what Mimir ships until Mimir can take 1.22.x (see #108, #129)",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/twmb/franz-go"
            ],
            "allowedVersions": "<=1.21.6"
        },
        {
            "description": "kfake digest bumps pull franz-go forward (#112), hold them too",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/twmb/franz-go/pkg/kfake",
                "github.com/twmb/franz-go/pkg/kmsg"
            ],
            "enabled": false
        },
        {
            "description": "Mimir imports these directly and ships older versions, a newer wgo requirement would move Mimir on revendor (see #130). Lift when Mimir bumps them",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/klauspost/compress",
                "github.com/pierrec/lz4/v4",
                "github.com/prometheus/common"
            ],
            "enabled": false
        }
    ]
}
